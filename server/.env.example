# Linkly Environment Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port number for the application server
PORT=4000

# Node environment (development, production, test)
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://linkly_user:your_secure_password@localhost:5432/linkly_db"

# Docker PostgreSQL configuration
POSTGRES_USER=linkly_user
POSTGRES_DB=linkly_db
POSTGRES_PASSWORD=your_secure_password

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT secret key for token signing (use a strong, random string in production)
JWT_SECRET="your_super_secret_jwt_key_change_this_in_production"

# JWT token expiration time
JWT_EXPIRES_IN="7d"

# API key for admin operations (optional)
ADMIN_API_KEY="admin_api_key_change_this"

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL="debug"

# Log file paths (optional, defaults to logs/ directory)
COMBINED_LOG_PATH="logs/combined.log"
ERROR_LOG_PATH="logs/error.log"

# =============================================================================
# CACHING CONFIGURATION (Future Implementation)
# =============================================================================

# Redis connection URL
REDIS_URL="redis://localhost:6379"

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# RATE LIMITING CONFIGURATION (Future Implementation)
# =============================================================================

# Rate limiting window in milliseconds (15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# URL SHORTENING CONFIGURATION (Future Implementation)
# =============================================================================

# Default short code length
SHORT_CODE_LENGTH=6

# Base URL for shortened links
BASE_URL="http://localhost:4000"

# Custom domain support (optional)
CUSTOM_DOMAIN=""

# =============================================================================
# ANALYTICS CONFIGURATION (Future Implementation)
# =============================================================================

# Enable/disable analytics tracking
ANALYTICS_ENABLED=true

# GeoIP service API key (for location tracking)
GEOLOCATION_API_KEY="your_geolocation_api_key"

# Google Analytics tracking ID (optional)
GA_TRACKING_ID=""

# =============================================================================
# EMAIL CONFIGURATION (Future Implementation)
# =============================================================================

# SMTP configuration for email notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_email_password"

# Email sender information
FROM_EMAIL="noreply@linkly.com"
FROM_NAME="Linkly URL Shortener"

# =============================================================================
# EXTERNAL SERVICES (Future Implementation)
# =============================================================================

# AWS S3 configuration (for file uploads)
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="linkly-uploads"

# Cloudflare configuration (for CDN)
CLOUDFLARE_API_TOKEN="your_cloudflare_token"
CLOUDFLARE_ZONE_ID="your_zone_id"

# =============================================================================
# MONITORING & OBSERVABILITY (Future Implementation)
# =============================================================================

# Sentry DSN for error tracking
SENTRY_DSN="your_sentry_dsn"

# New Relic license key
NEW_RELIC_LICENSE_KEY="your_new_relic_key"

# Prometheus metrics endpoint
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# =============================================================================
# FEATURE FLAGS (Future Implementation)
# =============================================================================

# Enable/disable specific features
FEATURE_CUSTOM_DOMAINS=false
FEATURE_ANALYTICS_DASHBOARD=false
FEATURE_BULK_OPERATIONS=false
FEATURE_QR_CODES=false
FEATURE_WEBHOOKS=false

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Debug mode for development
DEBUG_MODE=true

# Pretty print logs in development
PRETTY_LOGS=true

# Enable API documentation
API_DOCS_ENABLED=true

# Hot reload for development
HOT_RELOAD=true

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test database URL (for running tests)
TEST_DATABASE_URL="postgresql://linkly_user:test_password@localhost:5432/linkly_test_db"

# Mock external services in tests
MOCK_EXTERNAL_SERVICES=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# CORS credentials
CORS_CREDENTIALS=true

# =============================================================================
# SESSION CONFIGURATION (Future Implementation)
# =============================================================================

# Session secret
SESSION_SECRET="your_session_secret_change_this"

# Session store (memory, redis, database)
SESSION_STORE="memory"

# Session cookie settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE=86400000